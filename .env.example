# ──────────────────────────────────────────────────────────────────────────
# Borkd Landing — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────
#
# 1. Copy this file to `.env.local` for local development:
#      cp .env.example .env.local
# 2. Fill in real values in `.env.local` (gitignored — never commit).
# 3. For Vercel deployments, set the same keys in:
#      Project Settings → Environment Variables
# 4. NEXT_PUBLIC_* keys are exposed to the browser — never put secrets there.
# 5. Keys WITHOUT the NEXT_PUBLIC_ prefix are server-only (API routes,
#    Server Components, Server Actions). Never import them into Client
#    Components — Next.js will throw a build error if you do.
#
# This file (.env.example) IS committed; it documents required env vars
# without exposing any real values.
# ──────────────────────────────────────────────────────────────────────────

# === Public (browser-exposed) ===
# NEXT_PUBLIC_SITE_URL=https://www.borkd.app

# === Server-only secrets (DO NOT expose) ===
# Add as needed when integrating waitlist/contact form/analytics:

# Supabase — SOURCE OF TRUTH for waitlist signups
# (app/api/waitlist/route.ts → public.waitlist_signups).
# Both are REQUIRED; without them the route returns 503. Service-role
# key bypasses RLS, so it is server-only — never NEXT_PUBLIC_.
# Project: Borkd (ubkteksfmzxfhsphroog). Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — BEST-EFFORT mirror of each signup into a Resend audience so
# launch broadcasts have an audience to target. Both RESEND_API_KEY and
# RESEND_AUDIENCE_ID are needed for the mirror; missing either → signup
# still recorded in Supabase, mirror is skipped (warn-only).
# Get a key at https://resend.com/api-keys (needs Contacts: write).
RESEND_API_KEY=

# REQUIRED for mirror: the audience id that launch broadcasts will
# target. Find it at https://resend.com/audiences — typically "General".
# Without this we'd be calling POST /contacts, which creates an
# org-level contact NOT visible in any audience, so broadcasts can't
# reach those signups.
RESEND_AUDIENCE_ID=

# Optional: tag mirrored contacts into a Resend segment so launch
# broadcasts can target a subset of the audience. Leave empty for
# unsegmented (all audience contacts get the broadcast).
RESEND_WAITLIST_SEGMENT_ID=

# GOOGLE_RECAPTCHA_SECRET=
